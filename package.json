{
  "name": "board-rush-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Board Rush Arcade — Main hub with installable PWA games",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist",
    "clean": "node -e \"const fs=require('fs');['dist','dist-pwa','games/*/dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "electron:dev": "node scripts/build.mjs && electron .",
    "electron:build": "node scripts/build.mjs && electron-builder --win --x64",
    "deploy:sftp": "node scripts/deploy-sftp.mjs",
    "deploy": "node scripts/build.mjs && node scripts/deploy-sftp.mjs"
  },
  "workspaces": [
    "games/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "phaser": "^3.80.1",
    "ssh2-sftp-client": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.minitoon.boardrush",
    "productName": "Minitoon Board Rush",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    }
  }
}