{
  "name": "dars-islam",
  "version": "1.0.0",
  "private": true,
  "description": "dars-islam — free Islamic education games platform: Quran, Arabic, Islamic studies, and core school subjects, as installable PWA games",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist",
    "clean": "node -e \"const fs=require('fs');['dist','dist-pwa','games/*/dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "generate:turbo-drift-models": "npm --workspace @turbo-drift/game run generate-models",
    "generate:turbo-drift-models:view-api": "npm --workspace @turbo-drift/game run generate-models:view-api",
    "electron:dev": "node scripts/build.mjs && electron .",
    "electron:build": "node scripts/build.mjs && electron-builder --win --x64",
    "deploy:sftp": "node scripts/deploy-sftp.mjs",
    "deploy": "node scripts/build.mjs && node scripts/deploy-sftp.mjs",
    "generate:game-icons": "node scripts/generate-game-icons.mjs",
    "test": "tsx tests/logic.test.ts && tsx tests/integration.test.ts && tsx tests/security.test.ts && tsx tests/player-progress.test.ts && tsx tests/builder-pieces.test.ts && tsx tests/mode-scenes.test.ts",
    "test:logic": "tsx tests/logic.test.ts",
    "test:integration": "tsx tests/integration.test.ts",
    "test:security": "tsx tests/security.test.ts",
    "test:player-progress": "tsx tests/player-progress.test.ts",
    "test:builder-pieces": "tsx tests/builder-pieces.test.ts",
    "test:mode-scenes": "tsx tests/mode-scenes.test.ts"
  },
  "workspaces": [
    "games/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "phaser": "^3.80.1",
    "ssh2-sftp-client": "^9.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.dars-islam.boardrush",
    "productName": "dars-islam Board Rush",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    }
  }
}
