{
  "name": "board-rush-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Board Rush Arcade — Main hub with installable PWA games",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist",
    "clean": "node -e \"const fs=require('fs');['dist','dist-pwa','games/*/dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "deploy": "node scripts/deploy.mjs"
  },
  "workspaces": [
    "games/*"
  ],
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}