
AddType application/wasm .wasm

# Force HTTPS redirect
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Vite SPA Routing
# Serve real files and directories as-is; route all other requests to index.html
# This allows the wrapper SPA and nested games (like /games/board-rush/) to handle their own routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If it's a real file, serve it (don't rewrite)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If it's a real directory, serve it (don't rewrite)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → /index.html (wrapper hub SPA handles routing)
  RewriteRule . /index.html [L]
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml application/xhtml+xml application/rss+xml image/svg+xml image/x-icon font/ttf font/otf font/woff application/vnd.ms-fontobject
  <IfModule mod_headers.c>
    Header append Vary User-Agent
  </IfModule>
</IfModule>
