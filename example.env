# Copy this file to .env (and/or .env.local) in the repo root and fill in real values.
# .env and .env.local are both gitignored — never commit real secrets.

# --- Supabase (multiplayer) ---------------------------------------------
# Read by Vite via import.meta.env, so these must live in .env.local
# (repo root) to be picked up by the build. See src/net/supabaseClient.ts.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE
# Legacy alias, used as a fallback if VITE_SUPABASE_PUBLISHABLE_KEY is unset
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- Hunyuan3D model generation (games/turbo-drift) ----------------------
# Used by games/turbo-drift/src/scripts/generate-models.ts
# Defaults to http://localhost:8081 if omitted.
HUNYUAN_URL=http://localhost:8081
# Hours to wait for an async generation job before timing out.
# HUNYUAN_STATUS_TIMEOUT_HOURS=1

# --- Deploy (scripts/deploy.mjs, scripts/deploy-sftp.mjs) ----------------
DEPLOY_HOST=darsislam.games
DEPLOY_USER=www
DEPLOY_PATH=/var/www/darsislam.games
SSH_PORT=22
# One of the two below, depending on your auth method:
# DEPLOY_PASSWORD=
# DEPLOY_SSH_KEY=
